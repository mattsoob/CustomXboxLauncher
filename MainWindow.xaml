<Window x:Class="XboxLauncherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox 360 Dashboard"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#121212"
        Foreground="#FFFFFF"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Horizontal Metro Header Style -->
        <Style x:Key="MetroTabHeader" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <TextBlock x:Name="HeaderText" 
                                   Text="{TemplateBinding Header}" 
                                   FontSize="20" 
                                   FontWeight="Normal" 
                                   Foreground="#777777" 
                                   Margin="16,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderText" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="HeaderText" Property="FontSize" Value="24"/>
                                <Setter TargetName="HeaderText" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metro Tile Hover & Focus Animation Style -->
        <Style x:Key="MetroTileButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="#107C41" 
                                BorderThickness="0" 
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Dashboard Radial Gradient Background -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#2D2D2D" Offset="0.0"/>
                    <GradientStop Color="#181818" Offset="0.6"/>
                    <GradientStop Color="#0D0D0D" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="50,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Top Gamerpic Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Rectangle Width="32" Height="32" Fill="#107C41" RadiusX="3" RadiusY="3"/>
            </StackPanel>

            <!-- Main Tab Container -->
            <TabControl x:Name="BladesTabControl" Grid.Row="0" Grid.RowSpan="2" 
                        Background="Transparent" BorderThickness="0" 
                        SelectionChanged="BladesTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab Headers -->
                            <TabPanel Grid.Row="0" IsItemsHost="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Animated Active View Container -->
                            <Grid Grid.Row="1" x:Name="ContentHolder">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ContentTranslate" X="0"/>
                                </Grid.RenderTransform>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- 1. BING TAB -->
                <TabItem Header="bing" Style="{StaticResource MetroTabHeader}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Search Games &amp; Media" FontSize="20" Foreground="#888888"/>
                    </StackPanel>
                </TabItem>

                <!-- 2. HOME TAB -->
                <TabItem Header="home" IsSelected="True" Style="{StaticResource MetroTabHeader}">
                    <Grid Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="130"/>
                        </Grid.RowDefinitions>

                        <!-- My Pins Tile -->
                        <Button Grid.Row="0" Grid.Column="0" Margin="5" Style="{StaticResource MetroTileButton}" Background="#107C41">
                            <Border Padding="12">
                                <Grid>
                                    <TextBlock Text="📌" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White"/>
                                    <TextBlock Text="My Pins" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="White"/>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Recent Tile -->
                        <Button Grid.Row="1" Grid.Column="0" Margin="5" Style="{StaticResource MetroTileButton}" Background="#107C41">
                            <Border Padding="12">
                                <Grid>
                                    <TextBlock Text="⏱" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White"/>
                                    <TextBlock Text="Recent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="White"/>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Main Hero Center Tile -->
                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5" Style="{StaticResource MetroTileButton}" Background="#151515">
                            <Grid>
                                <TextBlock Text="Featured Title" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border VerticalAlignment="Bottom" Background="#DD000000" Padding="12">
                                    <TextBlock Text="Play Current Game" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Right Top Tile -->
                        <Button Grid.Row="0" Grid.Column="2" Margin="5" Style="{StaticResource MetroTileButton}" Background="#1C1C1C">
                            <Border Padding="10">
                                <Grid>
                                    <TextBlock Text="Kinect Central" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Right Bottom Tile -->
                        <Button Grid.Row="1" Grid.Column="2" Margin="5" Style="{StaticResource MetroTileButton}" Background="#1C1C1C">
                            <Border Padding="10">
                                <Grid>
                                    <TextBlock Text="Community" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>
                </TabItem>

                <!-- 3. SOCIAL TAB -->
                <TabItem Header="social" Style="{StaticResource MetroTabHeader}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Friends &amp; Avatars" FontSize="20" Foreground="#888888"/>
                    </StackPanel>
                </TabItem>

                <!-- 4. GAMES TAB -->
                <TabItem Header="games" Style="{StaticResource MetroTabHeader}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="0,20,0,0">
                        <ItemsControl x:Name="GameLibraryItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="GameCard_Click" Tag="{Binding LaunchUri}" Style="{StaticResource MetroTileButton}" Width="170" Height="250" Margin="6" Background="#107C41">
                                        <Border Padding="12">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- 5. TV & MOVIES TAB -->
                <TabItem Header="tv &amp; movies" Style="{StaticResource MetroTabHeader}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Movies &amp; TV Services" FontSize="20" Foreground="#888888"/>
                    </StackPanel>
                </TabItem>

                <!-- 6. MUSIC TAB -->
                <TabItem Header="music" Style="{StaticResource MetroTabHeader}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Music Apps &amp; Player" FontSize="20" Foreground="#888888"/>
                    </StackPanel>
                </TabItem>

                <!-- 7. APPS TAB -->
                <TabItem Header="apps" Style="{StaticResource MetroTabHeader}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Application Library" FontSize="20" Foreground="#888888"/>
                    </StackPanel>
                </TabItem>

                <!-- 8. SETTINGS TAB -->
                <TabItem Header="settings" Style="{StaticResource MetroTabHeader}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                        <TextBlock Text="System Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <Button Content="Scan PC for Games" Click="ScanGamesButton_Click" Height="42" Style="{StaticResource MetroTileButton}" Background="#107C41" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Bottom Controller Footer -->
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="10" Height="10" Fill="#107C41" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="(A) Select" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Top Right Welcome Notification Banner -->
        <Border x:Name="WelcomeBanner" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,30,-350,0" 
                Width="320" 
                Height="65" 
                Background="#107C41" 
                CornerRadius="4,0,0,4" 
                Panel.ZIndex="99">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BannerTransform" X="0"/>
            </Border.RenderTransform>
            <Border Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Icon Placeholder -->
                    <Border Grid.Column="0" Width="38" Height="38" Background="#1C1C1C" CornerRadius="2">
                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- User Text Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Welcome" Foreground="#DDFFFFFF" FontSize="13" FontWeight="Normal"/>
                        <TextBlock x:Name="WelcomeUserNameText" Text="User" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Single Xbox 360 Boot Splash Screen Layer -->
        <MediaElement x:Name="StartupMedia"
                      Grid.RowSpan="3"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Close"
                      Stretch="Fill"
                      MediaEnded="StartupMedia_MediaEnded"
                      Visibility="Visible"/>
    </Grid>
</Window>